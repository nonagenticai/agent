{
	"extends": "$app/tsconfig",
	"include": [
		"src/**/*.js",
		"src/**/*.ts",
		"src/**/*.svelte",
		"tests/**/*.js",
		"tests/**/*.ts",
		"tests/**/*.svelte",
		"scripts/**/*.ts",
		"vite.config.ts"
	],
	"compilerOptions": {
		"strict": true,
		"moduleResolution": "bundler",
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		// web/scripts/*.ts run under node's type stripping, which needs `.ts` import paths
		"allowImportingTsExtensions": true
	}
}
