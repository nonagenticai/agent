{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"strict": true,
		"moduleResolution": "bundler",
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		// web/scripts/*.ts run under node's type stripping, which needs `.ts` import paths
		"allowImportingTsExtensions": true
	}
}
